# Copiá este archivo a .env y completá con los valores de ../.env.local
# No subas valores reales al repositorio.

NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Confirmación al crear un turno
WHATSAPP_CONFIRMATION_ENABLED=true

# Recordatorio ~24 horas antes
WHATSAPP_REMINDER_24H_ENABLED=true

# Recordatorio ~2 horas antes
WHATSAPP_REMINDER_2H_ENABLED=false

# Intervalo del poller en milisegundos (default 60s)
WHATSAPP_POLL_INTERVAL=60000

# Ventana de tolerancia para recordatorios (minutos)
WHATSAPP_REMINDER_WINDOW_MINUTES=30

# Puerto HTTP local de estado (solo localhost)
WHATSAPP_STATUS_PORT=3100

# Zona horaria (debe coincidir con system_settings.timezone)
WHATSAPP_TIMEZONE=America/Argentina/Buenos_Aires

# Nombre profesional en los mensajes (fallback si no hay system_settings)
WHATSAPP_PROFESSIONAL_NAME=Pamela, Lic. en Nutrición
