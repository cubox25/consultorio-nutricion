# Copiá a .env.local (Next.js) y/o whatsapp-service/.env
# No subas valores reales.

# --- Vercel / Next.js (Production + Preview) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor (NUNCA NEXT_PUBLIC_): API routes, Storage admin, WhatsApp queue
SUPABASE_SERVICE_ROLE_KEY=
# URL canónica del sitio (SEO, redirects, Open Graph). Ej: https://tudominio.com
NEXT_PUBLIC_SITE_URL=

# Playwright E2E (solo local; no configurar en Vercel Production)
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
# Opcional: UUID de un paciente para probar /admin/pacientes/[id]
E2E_PATIENT_ID=
# PLAYWRIGHT_BASE_URL=http://localhost:3001

# --- WhatsApp Cloud API (Meta) — recomendado en Vercel ---
# Guía: docs/WHATSAPP-CLOUD-API-SETUP.md
# WHATSAPP_CLOUD_ENABLED=true
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_TEMPLATE_LANG=es
# WHATSAPP_TEMPLATE_CONFIRMATION=turno_confirmado
# WHATSAPP_TEMPLATE_REMINDER_24H=recordatorio_24h
# CRON_SECRET=
# Verify token del webhook Meta (vos lo inventás; mismo valor en Meta y Vercel)
# WHATSAPP_VERIFY_TOKEN=consultorio-wa-verify-cambia-esto

# --- Solo whatsapp-service (PC local; NO hace falta si Cloud API está activa) ---
# En Next local (no Vercel): 1 fuerza spawn/kill del worker; 0 lo desactiva.
# WHATSAPP_LOCAL_CONTROL=1
# Si Cloud API está ON, el worker local NO debe enviar (evita duplicados):
# WHATSAPP_CLOUD_ENABLED=true
WHATSAPP_CONFIRMATION_ENABLED=true
WHATSAPP_REMINDER_24H_ENABLED=true
WHATSAPP_REMINDER_2H_ENABLED=false
WHATSAPP_POLL_INTERVAL=60000
WHATSAPP_STATUS_PORT=3100
WHATSAPP_TIMEZONE=America/Argentina/Buenos_Aires
WHATSAPP_PROFESSIONAL_NAME=Pamela, Lic. en Nutrición
